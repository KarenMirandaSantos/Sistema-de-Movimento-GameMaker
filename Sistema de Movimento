// Controles WASD
var mover_direita_wasd = keyboard_check(ord("D"));
var mover_esquerda_wasd = keyboard_check(ord("A"));
var mover_cima_wasd = keyboard_check(ord("W"));
var mover_baixo_wasd = keyboard_check(ord("S"));

// Controles pelas setas
var mover_direita_seta = keyboard_check(vk_right);
var mover_esquerda_seta = keyboard_check(vk_left);
var mover_cima_seta = keyboard_check(vk_up);
var mover_baixo_seta = keyboard_check(vk_down);

// Junta os controles
var mover_direita = mover_direita_wasd || mover_direita_seta;
var mover_esquerda = mover_esquerda_wasd || mover_esquerda_seta;
var mover_cima = mover_cima_wasd || mover_cima_seta;
var mover_baixo = mover_baixo_wasd || mover_baixo_seta;

// Verifica se o jogador está parado
var jogador_parado = !(mover_direita || mover_esquerda || mover_cima || mover_baixo);

// Movimento para direita
if (mover_direita) {
    if (!place_meeting(x + velocidade, y, obj_parede)) {
        x += velocidade;
    } else {
        while (!place_meeting(x + 1, y, obj_parede)) {
            x += 1;
        }
    }

    sprite_index = spr_player_direita;
    ultima_direcao = "direita";
}

// Movimento para esquerda
if (mover_esquerda) {
    if (!place_meeting(x - velocidade, y, obj_parede)) {
        x -= velocidade;
    } else {
        while (!place_meeting(x - 1, y, obj_parede)) {
            x -= 1;
        }
    }

    sprite_index = spr_player_esquerda;
    ultima_direcao = "esquerda";
}

// Movimento para cima
if (mover_cima) {
    if (!place_meeting(x, y - velocidade, obj_parede)) {
        y -= velocidade;
    } else {
        while (!place_meeting(x, y - 1, obj_parede)) {
            y -= 1;
        }
    }

    sprite_index = spr_player_cima;
    ultima_direcao = "cima";
}

// Movimento para baixo
if (mover_baixo) {
    if (!place_meeting(x, y + velocidade, obj_parede)) {
        y += velocidade;
    } else {
        while (!place_meeting(x, y + 1, obj_parede)) {
            y += 1;
        }
    }

    sprite_index = spr_player_baixo;
    ultima_direcao = "baixo";
}

// Sprite parado
if (jogador_parado) {

    switch (ultima_direcao) {

        case "direita":
            sprite_index = spr_player_parado_direita;
        break;

        case "esquerda":
            sprite_index = spr_player_parado_esquerda;
        break;

        case "cima":
            sprite_index = spr_player_parado_cima;
        break;

        case "baixo":
            sprite_index = spr_player_parado_baixo;
        break;
    }
}
